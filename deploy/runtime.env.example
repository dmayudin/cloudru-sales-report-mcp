CLOUDRU_MCP_TRANSPORT=streamable-http
CLOUDRU_MCP_PUBLIC_URL=https://203-0-113-10.sslip.io/mcp
CLOUDRU_PROJECT_ID=
CLOUDRU_ALLOW_WRITES=0
CLOUDRU_DEPLOYMENT_FILE=/etc/cloudru-sales/deployment.json
CLOUDRU_STATE_DIR=/var/lib/cloudru-sales
CLOUDRU_IMPORT_DIR=/var/lib/cloudru-sales/imports
# vm-setup.sh installs OpenTofu and links it here (HashiCorp downloads are unavailable from RU networks)
CLOUDRU_TERRAFORM_BIN=/usr/local/bin/terraform
CLOUDRU_TARIFF_FILE=/etc/cloudru-sales/tariffs.json
CLOUDRU_CH_DATABASE=sales_report
CLOUDRU_CH_USER=sales_importer
CLOUDRU_CH_URL=
# Cloud.ru External Root CA (download from the official docs page, verify the fingerprint)
CLOUDRU_CH_CA_FILE=/etc/cloudru-sales/cloudru-root-ca.pem
# External BI host (internal-evobi-* does not resolve from the VM subnet); same private CA chain
CLOUDRU_BI_URL=
CLOUDRU_BI_CA_FILE=/etc/cloudru-sales/cloudru-root-ca.pem
