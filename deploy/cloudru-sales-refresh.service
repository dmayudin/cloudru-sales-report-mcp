[Unit]
Description=Refresh sales snapshot in Cloud.ru
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=cloudru-sales
Group=cloudru-sales
WorkingDirectory=/opt/cloudru-sales-mcp
EnvironmentFile=/etc/cloudru-sales/runtime.env
EnvironmentFile=/etc/cloudru-sales/secrets.env
EnvironmentFile=/var/lib/cloudru-sales/bound.env
ExecStart=/opt/cloudru-sales-mcp/.venv/bin/python -m cloudru_mcp.refresh --source
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077
TimeoutStartSec=300
